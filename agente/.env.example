# Copia este archivo a .dev.vars para desarrollo local (wrangler dev) y llénalo.
# En producción: npx wrangler secret put <NOMBRE>. Nunca subas valores reales al repositorio.

# Obligatoria para conversar con el agente (no la necesita demo.ts ni los tests)
OPENROUTER_API_KEY=

# Opcional: si se define, el front debe enviar el encabezado x-access-key con este valor
ACCESS_KEY=

# Opcional: habilita POST /api/reset (borra out/ en el Worker) con el encabezado x-admin-key
ADMIN_KEY=

# Configuración no secreta (ya tiene valores por defecto en wrangler.jsonc)
# LLM_MODEL=anthropic/claude-haiku-5.5
# MAX_ITERACIONES=25
# MAX_TOKENS_SESION=300000
# MAX_TOKENS_DIA=3000000
# MAX_COSTO_USD=5
# LLM_TIMEOUT_MS=25000
# MAX_DURACION_TURNO_MS=30000
# MAX_CARACTERES_MENSAJE=4000
# ALLOWED_ORIGINS=http://localhost:3000,https://reto03-oc-front.vercel.app
